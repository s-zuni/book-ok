# Explicitly keep essential UI icons, logos and mobile app launcher assets
!public/icons/*
!public/images/*
!assets/*
!app/favicon.ico
!android/app/src/main/res/mipmap-*/*
!android/app/src/main/res/drawable*/*
!ios/App/App/Assets.xcassets/**/*
!docs/designs/*.svg

# Next.js & Web Build Outputs
/.next/
/out/
/build
/dist
/coverage

# TypeScript
*.tsbuildinfo
next-env.d.ts

# Environment variables
.env*
!.env.example

